FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml .
RUN pip install --no-cache-dir fastapi uvicorn pydantic sqlmodel psycopg[binary] httpx jinja2 pyyaml structlog
COPY packages packages
COPY results results
COPY data/prices data/prices
COPY config config
EXPOSE 80
CMD ["uvicorn", "packages.api.app:app", "--host", "0.0.0.0", "--port", "80"]
