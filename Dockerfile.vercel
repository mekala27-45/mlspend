FROM python:3.12-slim@sha256:b18b261e1b4974b4f321451ad5251ded85abb22c2b8b262da527dda1d031ab30
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt \
    && groupadd --gid 10001 mlspend \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin mlspend
COPY packages ./packages
COPY data/prices ./data/prices
COPY results ./results
COPY index.py ./
USER 10001:10001
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1/health', timeout=4)" || exit 1
CMD ["uvicorn", "packages.api.app:app", "--host", "0.0.0.0", "--port", "80", "--workers", "1"]
